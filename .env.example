# Local app
APP_HOST=127.0.0.1
APP_PORT=8787
DATABASE_PATH=data/heidi_leads.db

# Local Ollama. The app sends page text only to this local endpoint.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT_SECONDS=150

# Optional paid/licensed search provider. If blank, the app uses DDGS metasearch.
# For commercial use, configure a search provider whose terms permit your use case.
SERPER_API_KEY=

# Search and crawl safety limits
MAX_PAGES_PER_COMPANY=4
REQUEST_TIMEOUT_SECONDS=12
CRAWL_DELAY_SECONDS=0.6
