# Local app
APP_HOST=127.0.0.1
APP_PORT=8787
DATABASE_PATH=data/heidi_leads.db
ENVIRONMENT=local
DATABASE_URL=
CORS_ORIGINS=http://127.0.0.1:8787,http://localhost:8787,https://companyatlas-eight.vercel.app

# Local Ollama. The app sends page text only to this local endpoint.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT_SECONDS=150

# Optional paid/licensed search provider. If blank, the app uses DDGS metasearch.
# For commercial use, configure a search provider whose terms permit your use case.
SERPER_API_KEY=

# Production authentication (Supabase Auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Production durable research queue (Upstash Redis REST)
REDIS_URL=
REDIS_TOKEN=
QUEUE_KEY=heidi:research:jobs

# Vercel frontend -> persistent backend URL
BACKEND_API_URL=

# Search and crawl safety limits
MAX_PAGES_PER_COMPANY=4
REQUEST_TIMEOUT_SECONDS=12
CRAWL_DELAY_SECONDS=0.6
